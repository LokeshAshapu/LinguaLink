{
  "openapi": "3.0.3",
  "info": {
    "title": "LinguaLink Core API",
    "description": "Real-time Multilingual Voice Communication Platform API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "displayName": { "type": "string" },
                  "nativeLanguage": { "type": "string", "example": "te-IN" },
                  "preferredListeningLanguage": { "type": "string", "example": "hi-IN" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and return JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/calls/initiate": {
      "post": {
        "summary": "Initiate a voice call session",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receiverId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Call created with LiveKit token" }
        }
      }
    },
    "/metrics/latency": {
      "get": {
        "summary": "Retrieve pipeline latency metrics and status",
        "responses": {
          "200": { "description": "Latency report returned" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
