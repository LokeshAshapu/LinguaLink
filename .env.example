# LINGUALINK CORE v0.1 — ENVIRONMENT VARIABLES

# Application Setup
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d
ARGON2_SALT_LENGTH=16

# Database (PostgreSQL)
DATABASE_URL=postgresql://lingualink_user:lingualink_pass@localhost:5432/lingualink_db?schema=public

# Cache & PubSub (Redis)
REDIS_URL=redis://localhost:6379

# WebRTC / Media Server (LiveKit)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret

# AI Gateway Providers Configuration
# Supported STT Providers: mock | whisper | deepgram | google
STT_PROVIDER=mock
STT_API_KEY=c049532bc44742aa95894ba5b9ac73c6

# Supported Translation Providers: mock | openai | google | azure
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=c049532bc44742aa95894ba5b9ac73c6

# Supported TTS Providers: mock | elevenlabs | google | azure
TTS_PROVIDER=mock
TTS_API_KEY=c049532bc44742aa95894ba5b9ac73c6

# AI Gateway Circuit Breaker & Controls
AI_REQUEST_TIMEOUT_MS=5000
MAX_CALL_DURATION_SECONDS=3600
AUTO_LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.75

# Feature Flags
FLAG_AUTO_LANGUAGE_DETECTION=true
FLAG_LIVE_CAPTIONS=true
FLAG_VOICE_TRANSLATION=true
FLAG_TEXT_FALLBACK=true
FLAG_CONVERSATION_CONTEXT=true
